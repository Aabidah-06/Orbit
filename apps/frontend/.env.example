# Orbit Frontend Environment Variables

# Base URL for the Orbit Express + Supabase Merchant API
NEXT_PUBLIC_ORBIT_API_URL=http://localhost:3001

# Flag to enable hard-coded mock data for demos and offline previews (true/false)
NEXT_PUBLIC_DEMO_MODE=false

# Hosted checkout Soroban handshake (public contract/network configuration)
NEXT_PUBLIC_ORBIT_CONTRACT_ID=
NEXT_PUBLIC_USDC_CONTRACT_ID=
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
