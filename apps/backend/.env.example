# ---------------------------------------------------------------------------
# Orbit Merchant API — environment template
# ---------------------------------------------------------------------------
#   cp .env.example .env    then fill in the secrets.
# `.env` is gitignored; this template is committed so the config shape is known.
# ---------------------------------------------------------------------------

PORT=3001

# --- Supabase ----------------------------------------------------------------
# >>> SECRET <<< Service-role key. Server-side only — never expose to the client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stellar / Soroban rail --------------------------------------------------
ORBIT_CONTRACT_ID=CAZBZBUWBSQYK2RZ6WHMXVDLIQHSU5WD7ANZYL6HLNSCRUOTNYCDYQNG
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# SAC USDC uses 7 decimals on this rail.
STELLAR_USDC_DECIMALS=7

# --- Idempotency & billing locks (optional, defaults shown) ------------------
# IDEMPOTENCY_KEY_TTL_SECONDS=86400
# IDEMPOTENCY_IN_PROGRESS_TIMEOUT_SECONDS=300
# PREPARE_LOCK_TTL_SECONDS=60

# --- Exchange rate oracle (optional, defaults shown) --------------------------
# Background worker refresh interval for the fiat -> USDC rate cache (5 min)
# ORACLE_SYNC_INTERVAL_MS=300000
# A fiat pull is rejected when the live rate moved more than this from the
# subscription's quoted rate (200 bps = 2%)
# ORACLE_SLIPPAGE_TOLERANCE_BPS=200
# Price feed request timeout (ms)
# ORACLE_FETCH_TIMEOUT_MS=6000

# --- Rate limiting (optional, defaults shown) ---------------------------------
# RATE_LIMIT_WINDOW_MS=60000
# API_KEY_RATE_LIMIT_MAX=100
# IP_RATE_LIMIT_MAX=300
# Set when behind a reverse proxy / load balancer so rate limits see the client IP
# TRUST_PROXY=1
